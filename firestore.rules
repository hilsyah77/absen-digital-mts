rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HADIR.GURU MTs — ATURAN KEAMANAN DATABASE TERTUTUP (RESTRICTED ACCESS)
    // =========================================================================
    // Tujuan:
    // 1. Publik / Bot / Pengguna tanpa autentikasi DITOLAK 100% (Deny by default).
    // 2. Guru hanya dapat melihat profil, jadwal, riwayat presensi & izin miliknya sendiri.
    // 3. Guru TIDAK BISA membaca data pribadi guru lain atau mengubah absensi yang sudah tercatat.
    // 4. Admin Madrasah memiliki hak kelola monitoring, approval izin, dan konfigurasi.
    // =========================================================================

    // Fungsi Pembantu (Security Helpers)
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    function isTeacher() {
      return isAuthenticated() && getUserData().role == 'teacher';
    }

    function isOwner(teacherId) {
      return isAuthenticated() && getUserData().teacherId == teacherId;
    }

    // -------------------------------------------------------------------------
    // DEFAULT DENY: Tolak seluruh akses yang tidak diizinkan secara eksplisit
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // 1. DATA PENGGUNA & PROFIL (USERS)
    // -------------------------------------------------------------------------
    match /users/{uid} {
      // Guru hanya bisa membaca dokumen akun miliknya sendiri; Admin bisa baca semua
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      // Pembuatan dan modifikasi akun hanya boleh dilakukan oleh Admin Madrasah
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. DATA PRESENSI HARIAN (ATTENDANCE)
    // -------------------------------------------------------------------------
    match /attendance/{attendanceId} {
      // Guru hanya bisa membaca presensi miliknya sendiri; Admin membaca monitoring seluruh madrasah
      allow read: if isAuthenticated() && (
        isOwner(resource.data.teacherId) || isAdmin()
      );

      // Guru hanya bisa mencatat absensi atas nama NIP/ID dirinya sendiri
      allow create: if isAuthenticated() && (
        (isTeacher() && request.resource.data.teacherId == getUserData().teacherId) ||
        isAdmin()
      );

      // Integritas Data: Guru tidak boleh mengubah/memalsukan data absen yang sudah tercatat
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. PENGAJUAN IZIN & SAKIT (LEAVES)
    // -------------------------------------------------------------------------
    match /leaves/{leaveId} {
      // Guru membaca pengajuan izinnya sendiri; Admin membaca semua untuk diverifikasi
      allow read: if isAuthenticated() && (
        isOwner(resource.data.teacherId) || isAdmin()
      );

      // Guru mengajukan izin untuk dirinya sendiri
      allow create: if isAuthenticated() && (
        request.resource.data.teacherId == getUserData().teacherId || isAdmin()
      );

      // Hanya Admin yang berhak menyetujui (Approve) atau menolak (Reject) izin
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 4. JURNAL MENGAJAR KBM & LOG KELAS (TEACHING LOGS)
    // -------------------------------------------------------------------------
    match /teaching_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.teacherId == getUserData().teacherId || isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        isOwner(resource.data.teacherId) || isAdmin()
      );
    }

    // -------------------------------------------------------------------------
    // 5. CHECK-IN MONITORING RUANG KELAS (CLASS CHECKINS)
    // -------------------------------------------------------------------------
    match /class_checkins/{checkInId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 6. KONFIGURASI MADRASAH, JADWAL & KALDIK (SCHOOL CONFIG)
    // -------------------------------------------------------------------------
    match /schools/{schoolId} {
      // Semua guru yang terautentikasi bisa membaca radius dan jam operasional
      allow read: if isAuthenticated();
      // Hanya Admin yang bisa mengubah konfigurasi geofence atau data sekolah
      allow write: if isAdmin();
    }

    match /holidays/{holidayId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
