rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HADIR.GURU MTs — ATURAN KEAMANAN DATABASE TERTUTUP (RESTRICTED ACCESS)
    // =========================================================================
    // Tujuan:
    // 1. Publik / Bot / Pengguna tanpa autentikasi DITOLAK 100% (Deny by default).
    // 2. Guru hanya dapat melihat profil, jadwal, riwayat presensi & izin miliknya sendiri.
    // 3. Guru TIDAK BISA membaca data pribadi guru lain atau mengubah absensi yang sudah tercatat.
    // 4. Admin Madrasah memiliki hak kelola monitoring, approval izin, dan konfigurasi.
    // =========================================================================

    // Fungsi Pembantu (Security Helpers)
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().get('role', '') == 'admin' ||
        request.auth.token.admin == true
      );
    }

    // -------------------------------------------------------------------------
    // DEFAULT DENY: Tolak seluruh akses yang tidak diizinkan secara eksplisit
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // 1. DATA PENGGUNA & PROFIL (USERS)
    // -------------------------------------------------------------------------
    match /users/{uid} {
      // Guru dan Admin dapat membaca akun miliknya; Admin membaca semua
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      // Pembuatan dan modifikasi profil oleh pengguna itu sendiri atau Admin
      allow create, update: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. DATA PRESENSI HARIAN (ATTENDANCE)
    // -------------------------------------------------------------------------
    match /attendance/{attendanceId} {
      // Guru dan Admin yang login dapat membaca monitoring presensi
      allow read: if isAuthenticated();

      // Guru dan Admin yang terautentikasi dapat mencatat dan memperbarui presensi (Check-in & Check-out)
      allow create, update: if isAuthenticated();

      // Integritas Data: Penghapusan data presensi / purge hanya boleh oleh Admin
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. PENGAJUAN IZIN & SAKIT (LEAVES)
    // -------------------------------------------------------------------------
    match /leaves/{leaveId} {
      // Semua pengguna terautentikasi dapat membaca izin; Guru mengajukan izin
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();

      // Hanya Admin yang berhak menyetujui (Approve), menolak (Reject), atau menghapus izin
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 4. JURNAL MENGAJAR KBM & LOG KELAS (TEACHING LOGS)
    // -------------------------------------------------------------------------
    match /teaching_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.teacherId == getUserData().teacherId || isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        isOwner(resource.data.teacherId) || isAdmin()
      );
    }

    // -------------------------------------------------------------------------
    // 5. CHECK-IN MONITORING RUANG KELAS (CLASS CHECKINS)
    // -------------------------------------------------------------------------
    match /class_checkins/{checkInId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 6. KONFIGURASI MADRASAH, JADWAL & KALDIK (SCHOOL CONFIG)
    // -------------------------------------------------------------------------
    match /schools/{schoolId} {
      // Semua guru yang terautentikasi bisa membaca radius dan jam operasional
      allow read: if isAuthenticated();
      // Hanya Admin yang bisa mengubah konfigurasi geofence atau data sekolah
      allow write: if isAdmin();
    }

    match /holidays/{holidayId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
